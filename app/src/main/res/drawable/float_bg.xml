<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主按钮：浅粉紫柔和渐变 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#FFF3D8F5"
                android:centerColor="#FFE7C4F0"
                android:endColor="#FFD6AEEB" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
    <!-- 顶部高光（奶玻璃质感） -->
    <item
        android:left="10dp"
        android:top="7dp"
        android:right="10dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#99FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>