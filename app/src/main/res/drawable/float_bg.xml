<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主按钮：粉紫渐变 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#FFA78BFA"
                android:centerColor="#FFB86CD8"
                android:endColor="#FFEC6BB8" />
            <stroke
                android:width="2dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
    <!-- 顶部高光（玻璃质感） -->
    <item
        android:left="9dp"
        android:top="6dp"
        android:right="9dp"
        android:bottom="19dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
